# Copy to deployer.env on the host. Keep secrets in the referenced env file,
# not in this repository.
IMAGE=ghcr.io/yeaft/yeaft-web-code-agent:dev
COMPOSE_PROJECT_NAME=termination
WEBCHAT_ENV_FILE=/home/azureuser/data/webchat-dev/.env

NGINX_CONTAINER=nginx_for_servers
UPSTREAM_FILE=/home/azureuser/projects/termination/nginx-upstreams/dev-cc.conf
UPSTREAM_NAME=dev_cc_backend
